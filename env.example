DATABASE_URL=postgres://watch:watch@localhost:5432/riyadhwatch
REDIS_URL=redis://localhost:6379
PORT=8080

# Optional third ADS-B provider (RapidAPI -> ADSB Exchange).
# The two free providers work without any key.
RAPIDAPI_KEY=

# Poll interval in ms. 5000 is polite to the free feeds; do not go below 2000.
TICK_MS=5000

# INGEST=off runs the API and dashboard without touching ADS-B or Redis.
INGEST=
